{
  "name": "tend-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Your thoughts, in Markdown. The native notes extension for Tend.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186",
    "check": "svelte-check --tsconfig tsconfig.json --threshold error",
    "test": "bun test tests/session.test.ts tests/organization.test.ts",
    "build": "vite build && python3 scripts/package.py",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "svelte": "5.57.0",
    "marked": "18.0.11",
    "dompurify": "3.4.14",
    "lucide-svelte": "0.454.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "vite": "8.2.2",
    "typescript": "5.9.3",
    "svelte-check": "4.7.3",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.10"
  }
}
